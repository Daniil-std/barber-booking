# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POSTGRES_DB=form_studio
POSTGRES_USER=form_studio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
SEED_DEMO_DATA=False

# Hosted PostgreSQL: overrides POSTGRES_* when nonempty. Never use SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL_REQUIRE=True
# Render sets RENDER_EXTERNAL_HOSTNAME; exact host + HTTPS CSRF origin are added.
# Custom domains: set DJANGO_ALLOWED_HOSTS and DJANGO_CSRF_TRUSTED_ORIGINS.
# DJANGO_HTTPS=True          # defaults to not DEBUG; False only for local HTTP
# DJANGO_TRUST_PROXY=False   # True only behind a trusted HTTPS proxy (Render)
# FRONTEND_DIST=/app/frontend/dist
